{
  "name": "dsh-workspace-overlay",
  "version": "0.1.0",
  "description": "Out-of-tree DSH plugin: canonical per-workspace Cordis scopes (workspaceCordis) with optional <workspace>/.dsh/cordis.yml composition mounting; rc.6-compatible MCP core (transport/tools/connection supervisor) under ./mcp.",
  "type": "module",
  "main": "./dist/registry.js",
  "exports": {
    ".": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./mcp/types": {
      "types": "./dist/mcp/types.d.ts",
      "default": "./dist/mcp/types.js"
    },
    "./mcp/config": {
      "types": "./dist/mcp/config.d.ts",
      "default": "./dist/mcp/config.js"
    },
    "./mcp/transport": {
      "types": "./dist/mcp/transport.d.ts",
      "default": "./dist/mcp/transport.js"
    },
    "./mcp/tools": {
      "types": "./dist/mcp/tools.d.ts",
      "default": "./dist/mcp/tools.js"
    },
    "./mcp/connection": {
      "types": "./dist/mcp/connection.d.ts",
      "default": "./dist/mcp/connection.js"
    },
    "./mcp/manager": {
      "types": "./dist/mcp/manager.d.ts",
      "default": "./dist/mcp/manager.js"
    },
    "./mcp/workspace-client": {
      "types": "./dist/mcp/workspace-client.d.ts",
      "default": "./dist/mcp/workspace-client.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./workspace-tree": {
      "types": "./dist/workspace-tree.d.ts",
      "default": "./dist/workspace-tree.js"
    },
    "./method-wrapper": {
      "types": "./dist/method-wrapper.d.ts",
      "default": "./dist/method-wrapper.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator.d.ts",
      "default": "./dist/coordinator.js"
    },
    "./agent-registry-decorator": {
      "types": "./dist/agent-registry-decorator.d.ts",
      "default": "./dist/agent-registry-decorator.js"
    },
    "./agent-integration": {
      "types": "./dist/agent-integration.d.ts",
      "default": "./dist/agent-integration.js"
    },
    "./agent-presets-decorator": {
      "types": "./dist/agent-presets-decorator.d.ts",
      "default": "./dist/agent-presets-decorator.js"
    },
    "./workspace-presets": {
      "types": "./dist/workspace-presets.d.ts",
      "default": "./dist/workspace-presets.js"
    },
    "./integration-plugin": {
      "types": "./dist/integration-plugin.d.ts",
      "default": "./dist/integration-plugin.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
